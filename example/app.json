{
  "expo": {
    "name": "expo-whisperkit-example",
    "slug": "expo-whisperkit-example",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "expo.modules.whisperkit.example"
    },
    "plugins": [
      ["../app.plugin.js", { "microphonePermission": "The example app listens so WhisperKit can transcribe." }]
    ]
  }
}
