{
  "name": "expo-whisperkit",
  "version": "0.1.0",
  "description": "WhisperKit on-device speech to text for Expo",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "files": [
    "build",
    "plugin/build",
    "app.plugin.js",
    "ios",
    "src",
    "expo-module.config.json",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.19.4"
  },
  "scripts": {
    "build": "node internal/module_scripts/build.js",
    "clean": "node internal/module_scripts/clean.js",
    "lint": "eslint src/ plugin/src/",
    "test": "node internal/module_scripts/test.js",
    "test:ios": "node internal/module_scripts/test-ios.js",
    "manifest": "node internal/module_scripts/manifest.js",
    "prepare": "node internal/module_scripts/prepare.js",
    "open:ios": "node internal/module_scripts/open-ios.js"
  },
  "keywords": ["react-native", "expo", "whisperkit", "speech-to-text", "expo-whisperkit"],
  "repository": "https://github.com/georgeelliott/expo-whisperkit",
  "bugs": { "url": "https://github.com/georgeelliott/expo-whisperkit/issues" },
  "author": "George Elliott <geehaws@gmail.com> (https://github.com/georgeelliott)",
  "license": "MIT",
  "homepage": "https://github.com/georgeelliott/expo-whisperkit#readme",
  "dependencies": {},
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.20.2",
    "@types/react": "~19.2.2",
    "babel-preset-expo": "~57.0.14",
    "eslint": "~9.39.4",
    "eslint-config-universe": "^15.0.3",
    "expo": "~57.0.27",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.5",
    "prettier": "^3.0.0",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "jest-expo/ios",
    "roots": ["<rootDir>/src"]
  },
  "peerDependencies": {
    "expo": "*",
    "react": "*",
    "react-native": "*"
  }
}
